---
/**
 * The 404 page.
 *
 * Sits at the site root with no locale segment on purpose: an unknown URL may
 * arrive as /pricing, /es/pricing or /nonsense, and none of those can be trusted
 * to carry a language. Copy is English because a single static file cannot be
 * translated per visitor, and the header, footer and links all point at /en/.
 *
 * Amplify currently answers every unknown URL with a "404-200" rewrite: it serves
 * the homepage with a 200 OK, so dead links claim to exist and never appear in
 * Search Console. This page exists so that rule can be changed to a real 404 —
 * that switch is a console change, not a code change.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const LINKS = [
  {
    href: '/en/blog/',
    label: 'Blog',
    body: 'Guides on tokens, model pricing and API costs.',
    path: 'M4 6h16M4 11h16M4 16h9',
  },
  {
    href: '/en/token-calculator/',
    label: 'Token calculator',
    body: 'Price a prompt across the models you are choosing between.',
    path: 'M9 7h6M9 11h6M9 15h3',
  },
  {
    href: '/en/contact/',
    label: 'Contact',
    body: 'Tell us what you were looking for and we will point you at it.',
    path: 'M4 6l8 5 8-5M4 6h16v12H4z',
  },
];
---

<BaseLayout
  title="Page not found — AI Token King"
  description="This URL does not exist on AI Token King. Links to the blog, the token calculator and contact."
  noindex={true}
  lang="en"
>
  <section class="notfound">
    <div class="notfound-inner">
      <p class="notfound-code">Error 404</p>
      <h1 class="notfound-title">This page does not exist</h1>
      <p class="notfound-body">
        The address may be mistyped, or it may point at something that has moved.
        Nothing here is broken on your side.
      </p>

      <div class="notfound-links">
        {LINKS.map(link => (
          <a class="notfound-card" href={link.href}>
            <span class="notfound-card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d={link.path} stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="notfound-card-text">
              <span class="notfound-card-label">{link.label}</span>
              <span class="notfound-card-body">{link.body}</span>
            </span>
            <svg class="notfound-card-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))}
      </div>

      <a class="btn-secondary notfound-home" href="/en/">Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    background:
      radial-gradient(ellipse 70% 60% at 75% 0%, rgba(97, 85, 241, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 45% 55% at 5% 100%, rgba(62, 129, 229, 0.1) 0%, transparent 55%),
      #F5F2FF;
    padding: 5rem 1.5rem 6rem;
  }
  .notfound-inner { max-width: 640px; margin: 0 auto; }

  .notfound-code {
    font-family: 'Kanit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6155F1;
    margin: 0 0 0.875rem;
  }

  .notfound-title {
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: #1C1C1C;
    margin: 0 0 1rem;
  }

  .notfound-body {
    font-size: 1rem;
    line-height: 1.75;
    color: #555;
    margin: 0 0 2.5rem;
  }

  .notfound-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .notfound-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 2px 10px rgba(97, 85, 241, 0.08);
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(.22, 1, .36, 1), box-shadow 0.18s ease;
  }
  .notfound-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(97, 85, 241, 0.16);
  }
  .notfound-card:focus-visible { outline: 2px solid #6155F1; outline-offset: 3px; }
  .notfound-card:active { transform: translateY(0); box-shadow: 0 2px 8px rgba(97, 85, 241, 0.12); }

  .notfound-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 11px;
    background: #E2DFFE;
    color: #6155F1;
  }

  .notfound-card-text { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
  .notfound-card-label {
    font-family: 'Kanit', sans-serif;
    font-size: 0.975rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1C1C1C;
  }
  .notfound-card-body {
    font-size: 0.825rem;
    line-height: 1.55;
    color: #666;
  }

  .notfound-card-arrow {
    flex-shrink: 0;
    color: #6155F1;
    transition: transform 0.18s cubic-bezier(.22, 1, .36, 1);
  }
  .notfound-card:hover .notfound-card-arrow { transform: translateX(3px); }

  .notfound-home { display: inline-flex; }

  @media (max-width: 640px) {
    .notfound { padding: 3.5rem 1.25rem 4.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-card,
    .notfound-card-arrow { transition: none; }
    .notfound-card:hover { transform: none; }
    .notfound-card:hover .notfound-card-arrow { transform: none; }
  }
</style>
