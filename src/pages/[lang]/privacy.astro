---
import LegalPage from '../../components/LegalPage.astro';
import { SUPPORTED_LANGS, isValidLang } from '../../i18n/index';
import type { Lang } from '../../i18n/index';
import { getLegalPage } from '../../lib/sanity';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!isValidLang(lang)) return Astro.redirect('/en/privacy/');

// Falls back to the English document when this locale has none — the cookie
// banner links here before asking for consent, so it must never 404.
const page = await getLegalPage('privacy', lang);
---

<LegalPage page={page} lang={lang as Lang} docType="privacy" />
