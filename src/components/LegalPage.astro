---
/**
 * Privacy Policy and Terms of Service.
 *
 * Deliberately plain next to the rest of the site: no gradient hero, no blobs,
 * no reveal animations. Someone reading this is checking what we do with their
 * data, and decoration competing with the text would be working against them.
 * One accent rule, a dated stamp, and a measure capped near 70 characters.
 *
 * The measure is right for reading and wrong for a 1440px window, which left the
 * page as a narrow ribbon in an empty field. The fix is the "On This Page" card
 * the provider and blog pages already use: it fills the column with something a
 * reader of a seven-section policy actually wants, and it costs the prose no
 * width — the article keeps its own 54ch cap, so the grid cannot stretch it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, LANG_META } from '../i18n/index';
import type { Lang } from '../i18n/index';
import { renderPortableText, headingAnchors } from '../lib/portable-text';
import type { LegalPageData, LegalDocType } from '../lib/sanity';

export interface Props {
  page: LegalPageData | null;
  lang: Lang;
  docType: LegalDocType;
}

const { page, lang, docType } = Astro.props;
const t = useTranslations(lang);
const locale = LANG_META[lang].locale;

// The document may be the English fallback; say so rather than leaving a reader
// wondering why the page switched language on them.
const isEnglishFallback = Boolean(page) && page!.language !== lang;

const titleFallback = docType === 'privacy' ? t('legal.privacyTitle') : t('legal.termsTitle');
const heading = page?.title ?? titleFallback;

const seoDescription = page?.seo?.seoDescription
  ?? (docType === 'privacy' ? t('legal.privacySeoDescription') : t('legal.termsSeoDescription'));

/** `lastUpdated` is a plain YYYY-MM-DD; build the date locally so it does not slip a day. */
function formatLastUpdated(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return new Date(year, month - 1, day).toLocaleDateString(locale, {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
const lastUpdatedLabel = page?.lastUpdated
  ? t('legal.lastUpdated').replace('{date}', formatLastUpdated(page.lastUpdated))
  : '';

// ── Section headings, for the sidebar and for deep links ───────────────────
// Read off the document itself: a policy that gains a section gains a sidebar
// entry with no edit here. A document with no h2 headings gets no card — there
// is nothing to list, and inventing section names would misdescribe the text.
const docSource = `legalPage/${page?.language ?? lang}/${docType}`;
const { headings, components: headingComponents } = headingAnchors(page?.body as any[] | undefined);

const bodyHtml = renderPortableText(page?.body as any[] | undefined, {
  source: docSource,
  components: headingComponents,
});

const otherDocType: LegalDocType = docType === 'privacy' ? 'terms' : 'privacy';
const otherDocLabel = otherDocType === 'privacy' ? t('footer.privacy') : t('footer.terms');
const showSidebar = headings.length > 0 || Boolean(lastUpdatedLabel);

// Nothing published yet: still serve the page so the consent banner's link is
// not a dead end, but keep it out of the index until there is a policy to read.
const noindex = page?.seo?.noindex ?? !page;
---

<BaseLayout
  title={page?.seo?.seoTitle ?? `${heading} — AI Token King`}
  description={seoDescription}
  noindex={noindex}
  lang={lang}
  seo={page?.seo}
>
  <div class:list={['legal-shell', showSidebar && 'legal-shell--split']}>
    <article class="legal-page">
      <header class="legal-head">
        <h1 class="legal-title">{heading}</h1>
        {lastUpdatedLabel && <p class="legal-updated"><time datetime={page!.lastUpdated}>{lastUpdatedLabel}</time></p>}
      </header>

      {isEnglishFallback && (
        <p class="legal-notice" lang="en">{t('legal.englishFallbackNotice')}</p>
      )}

      {page && bodyHtml
        ? <div class="prose legal-body" set:html={bodyHtml} />
        : (
          <p class="legal-notice legal-notice--empty">
            {t('legal.notPublished')}
            <a href={`/${lang}/contact/`}>{t('nav.contact')}</a>
          </p>
        )}
    </article>

    {showSidebar && (
      <aside class="legal-sidebar">
        {headings.length > 0 && (
          <div class="sidebar-card">
            <div class="sidebar-eyebrow">{t('common.onThisPage')}</div>
            <nav class="toc-nav" id="legal-toc" aria-label={t('common.aria.tableOfContents')}>
              {headings.map((h, index) => (
                <a href={`#${h.id}`} class={`sidebar-link${index === 0 ? ' active' : ''}`}>{h.text}</a>
              ))}
            </nav>
          </div>
        )}

        <div class="sidebar-card sidebar-info">
          <div class="sidebar-info-eyebrow">{t('legal.documentInfo')}</div>
          <div class="sidebar-info-rows">
            {lastUpdatedLabel && (
              <div class="sidebar-info-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="#999" stroke-width="1.75"/><path d="M16 2v4M8 2v4M3 10h18" stroke="#999" stroke-width="1.75" stroke-linecap="round"/></svg>
                <time datetime={page!.lastUpdated}>{lastUpdatedLabel}</time>
              </div>
            )}
            <a class="sidebar-info-link" href={`/${lang}/${otherDocType}/`}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 2v6h6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {otherDocLabel}
            </a>
          </div>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .legal-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
  }

  .legal-page {
    /* The `ch` unit measures the "0" glyph, which in Plus Jakarta Sans is wider
       than the average letter — 68ch measured out at 87 characters per line.
       54ch lands at ~69, inside the comfortable 60–75 reading range.

       This cap stays on the article itself, not only on the grid column, so the
       measure is safe whether or not the sidebar is showing. */
    max-width: 54ch;
    margin: 0 auto;
  }

  .legal-head {
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 2px solid #6155F1;
  }

  .legal-title {
    font-family: 'Kanit', sans-serif;
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #1C1C1C;
    margin: 0;
  }

  /* The date is the first thing a careful reader looks for, so it sits directly
     under the title rather than being buried at the foot of the document. */
  .legal-updated {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #6155F1;
  }

  .legal-notice {
    margin: 0 0 2rem;
    padding: 0.875rem 1.125rem;
    border-left: 3px solid #E8933D;
    border-radius: 0 8px 8px 0;
    background: #FDF6EC;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #92500E;
  }

  .legal-notice--empty { margin-bottom: 0; }

  .legal-notice a {
    margin-left: 0.4rem;
    color: #92500E;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }
  .legal-notice a:hover { color: #6D3B08; }
  .legal-notice a:focus-visible { outline: 2px solid #92500E; outline-offset: 2px; border-radius: 3px; }
  .legal-notice a:active { color: #5A3006; }

  /* Longer measure and looser leading than .prose gives elsewhere: this is dense
     text somebody reads top to bottom, not scans. */
  .legal-body.prose :global(p),
  .legal-body.prose :global(li) { line-height: 1.85; }
  .legal-body.prose :global(h2) { margin-top: 2.75rem; }
  .legal-body.prose :global(h2:first-child) { margin-top: 0; }
  /* Clear the sticky header when a sidebar link jumps to a section. */
  .legal-body.prose :global(h2),
  .legal-body.prose :global(h3) { scroll-margin-top: 88px; }

  /* ── Sidebar ───────────────────────────────────────────────────────────
     Same cards as the blog post and provider pages: white surface, purple
     eyebrow, pill-highlighted active link. Below 1024px it is dropped rather
     than stacked — a table of contents under the article it indexes is just
     the article again. */
  .legal-sidebar { display: none; }

  @media (min-width: 1024px) {
    .legal-shell--split {
      display: grid;
      grid-template-columns: minmax(0, 54ch) 240px;
      justify-content: center;
      align-items: start;
      gap: 4rem;
    }
    .legal-sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      position: sticky;
      top: 88px;
    }
  }

  .sidebar-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 2px 10px rgba(97, 85, 241, 0.08);
  }

  .sidebar-eyebrow {
    font-family: 'Kanit', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: #6155F1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.45rem 0.875rem;
    border-radius: 7px;
    font-size: 0.845rem;
    font-weight: 500;
    line-height: 1.45;
    color: #666;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .sidebar-link:hover { background: #F5F2FF; color: #6155F1; }
  .sidebar-link:focus-visible { outline: 2px solid #6155F1; outline-offset: 2px; }
  .sidebar-link:active { background: #E2DFFE; }
  .sidebar-link.active {
    background: #E2DFFE;
    color: #6155F1;
    font-weight: 600;
  }

  .sidebar-info { padding: 1.375rem; }
  .sidebar-info-eyebrow {
    font-family: 'Kanit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #3C315B;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }
  .sidebar-info-rows {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .sidebar-info-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.825rem;
    color: #666;
  }
  .sidebar-info-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: #6155F1;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .sidebar-info-link:hover { color: #4E44D4; }
  .sidebar-info-link:focus-visible { outline: 2px solid #6155F1; outline-offset: 2px; border-radius: 4px; }
  .sidebar-info-link:active { color: #3C315B; }

  @media (max-width: 640px) {
    .legal-shell { padding: 2.5rem 1.25rem 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-link,
    .sidebar-info-link { transition: none; }
  }
</style>

<script>
  // Scroll-spy, same shape as the blog post and provider pages: highlight the
  // section the reader is in. Links stay usable without this — they are plain
  // anchors — so nothing breaks if the observer never fires.
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#legal-toc .sidebar-link');
  const sections: HTMLElement[] = [];
  tocLinks.forEach(link => {
    const href = link.getAttribute('href') ?? '';
    if (!href.startsWith('#')) return;
    const target = document.getElementById(href.slice(1));
    if (target instanceof HTMLElement) sections.push(target);
  });

  if (sections.length > 0) {
    const spy = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        tocLinks.forEach(link => link.classList.remove('active'));
        document.querySelector(`#legal-toc .sidebar-link[href="#${entry.target.id}"]`)?.classList.add('active');
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(section => spy.observe(section));
  }
</script>
