        {
          "_key": "70i2mnvtc",
          "_type": "span",
          "marks": [],
          "text": "When evaluating AI services for token costs, look out for pricing tiers that offer discounts for bulk usage. These can be an excellent way to reduce your expenses over time."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
