# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables (keep .env.example tracked as template)
.env*
!.env.example

# fetch-script credentials — service-account JSON, OAuth creds/tokens. NEVER commit.
secrets/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# project-specific
temporary screenshots/
.claude/settings.local.json

# raw Make batch exports (processed copies live in scripts/data/posts-batch-*.json)
scripts/data/articles-batch-*.json

# defensive: prevent stray bare git clones from being committed if they ever land in the working tree
*.git/

# translation pipeline (intern: fetched English + translated output + reports)
translation/

# per-task progress docs (kept local — not part of the deliverable)
TASK*_PROGRESS.md

# persisted puppeteer profile used for screenshotting authenticated Sanity Studio
# (created locally by archive/sanity-auth-setup.mjs — never commit)
archive/.puppeteer-profile/

# August 2026 audit screenshots: ~83 MB of PNGs kept out of history (see audits/2026-08-06/README.md)
audits/2026-08-06/screenshots/
audits/2026-08-06/annotated/

# chat deliverables handed over from Claude sessions (not repo files)
Claude outputs/

# content corpus: 8 MB of post text, rebuilt by `node scripts/build-content-corpus.mjs`
audits/*/content-corpus.json
