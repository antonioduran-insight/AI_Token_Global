PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Sanity Editor token — only needed by write scripts (e.g. scripts/fix-article-numbers.mjs --write).
# Get one from sanity.io/manage → your project → API → Tokens. Keep it out of git: put the real
# value in .env.local or pass it inline, never here.
SANITY_TOKEN=
